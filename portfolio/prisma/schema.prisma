// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Example model - add your models here
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProjectType {
  DEVELOPMENT
  DESIGN
}

model Project {
  id          Int         @id @default(autoincrement())
  title       String
  description String?
  image       String?
  link        String?
  index       Int         @default(0)
  type        ProjectType @default(DEVELOPMENT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Visitor {
  id        Int      @id @default(autoincrement())
  ipAddress String?
  userAgent String?
  visitedAt DateTime @default(now())
  createdAt DateTime @default(now())
}

model GuestbookEntry {
  id        Int                  @id @default(autoincrement())
  name      String
  message   String
  email     String?
  ipAddress String?
  createdAt DateTime             @default(now())
  reactions GuestbookReaction[]

  @@index([createdAt])
}

model GuestbookReaction {
  id        Int             @id @default(autoincrement())
  emoji     String
  entryId   Int
  ipAddress String
  createdAt DateTime        @default(now())
  entry     GuestbookEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, ipAddress, emoji])
  @@index([entryId])
}

model Playground {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  embedUrl    String
  platform    String   // 'stackblitz' or 'codesandbox'
  tags        String[] // Array of technology tags
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}
